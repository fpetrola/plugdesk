<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.plugdesk.standard</groupId>
        <artifactId>standard</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>plugdesk-standard</artifactId>
    <name>Plugdesk :: The standard plugins, for an application to carry</name>
    <description>The standard plugins inside one jar: an application that depends on it starts with them installed.</description>

    <properties>
        <crystal.bundleGroupId>dev.plugdesk.standard</crystal.bundleGroupId>
        <crystal.bundleVersion>${project.version}</crystal.bundleVersion>
        <!-- Not a plugin: the jar the plugins travel in. -->
        <crystal.skip>true</crystal.skip>
    </properties>

    <!-- Built after them, so they are in the local repository when they are bundled; never on anyone's class path. -->
    <dependencies>
        <dependency>
            <groupId>dev.plugdesk.standard</groupId>
            <artifactId>desk-looks</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.plugdesk.standard</groupId>
            <artifactId>desk-suggestions</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.plugdesk.standard</groupId>
            <artifactId>desk-windows</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.plugdesk.standard</groupId>
            <artifactId>desk-docks</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.plugdesk.standard</groupId>
            <artifactId>desk-toolbar</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.plugdesk.standard</groupId>
            <artifactId>desk-help</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
