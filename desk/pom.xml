<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.plugdesk</groupId>
        <artifactId>plugdesk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>plugdesk-desk</artifactId>
    <name>Plugdesk :: Desk</name>
    <description>The window and what goes on it: menus, buttons and windows, each brought by an application or a plugin.</description>

    <dependencies>
        <dependency>
            <groupId>dev.plugdesk</groupId>
            <artifactId>plugdesk-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-api</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-runtime</artifactId>
        </dependency>
        <!-- What draws the SVG icons. It travels inside this jar, relocated: a plugin that carries its own jsvg, in
             another version (darklaf does), would otherwise be given this one, since crystal hands a plugin the
             application's copy of a library the application already has. -->
        <dependency>
            <groupId>com.github.weisj</groupId>
            <artifactId>jsvg</artifactId>
            <version>2.0.0</version>
        </dependency>
        <!-- Crystal's own panel for the plugins: what the plugins window shows. -->
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-swing</artifactId>
            <version>${crystal.version}</version>
        </dependency>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-build-processor</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.github.weisj:jsvg</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.github.weisj.jsvg</pattern>
                                    <shadedPattern>dev.plugdesk.desk.internal.jsvg</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>com.github.weisj:jsvg</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                            <dependencyReducedPomLocation>${project.build.directory}/dependency-reduced-pom.xml</dependencyReducedPomLocation>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
