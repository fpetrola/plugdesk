<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.plugdesk</groupId>
        <artifactId>plugdesk-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>plugdesk-app</artifactId>
    <name>Plugdesk :: App</name>
    <description>What an application needs to have plugins, with no toolkit: its home and settings, the plugins it has and where more come from, and a word for the person.</description>

    <dependencies>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-guice</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No roles here, so no processor: pf4j's would write an empty META-INF/extensions.idx into this jar, and every
                 plugin compiled with it on the class path would take that one for its own. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
